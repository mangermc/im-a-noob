# Keeps formatting consistent across editors and IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing spaces are meaningful in Markdown (line breaks).
[*.md]
trim_trailing_whitespace = false
